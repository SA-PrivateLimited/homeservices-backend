PORT=3001
NODE_ENV=development
MONGODB_URI=
MONGODB_DB_NAME=home-services
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_REGISTRATION_SECRET=

# Public Admin Web origin used to build activation links (no email).
# Example production: https://admin.homora.in
ADMIN_WEB_BASE_URL=http://localhost:5173

# Realtime: Socket.IO is attached to this same HTTP server (local / long-lived hosts).
# Mobile apps use SOCKET_URL = API host without /api (e.g. http://10.0.2.2:3001).
# Vercel serverless cannot keep WebSocket connections — deploy API on a persistent
# host for production sockets, or set WEBSOCKET_SERVER_URL as a temporary bridge
# to the legacy Cloud Run websocket-server until you retire it.
# WEBSOCKET_SERVER_URL=

# Firebase Admin (Phone Auth ID-token verify + FCM)
# Prefer config/firebase-admin.json (gitignored) or:
# SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# AUTH_OTP_PROVIDER=firebase   # or twilio for legacy SMS OTP
# ENABLE_FIREBASE=false        # optional: mint Firebase custom tokens on login

# Twilio Verify — only when AUTH_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEV_MODE=false

# AWS S3 + CloudFront — same bucket/CDN for local and production
# Production: EC2/ECS instance IAM role only (default credential chain).
# Local: use AWS_PROFILE / SSO that can assume the same role — never put access keys here.
# Do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=akanso-assets
AWS_CLOUDFRONT_DOMAIN=assets.akanso.in
# Must stay false so local+prod both use https://assets.akanso.in (not /uploads)
AWS_S3_LOCAL_FALLBACK=false
# Optional local SSO/profile (example): AWS_PROFILE=akanso-backend
PUBLIC_API_BASE_URL=http://127.0.0.1:3001
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=8
MAX_SERVICE_REQUEST_PHOTOS=3
# Optional: HMAC secret for local direct-upload tokens (defaults to JWT_SECRET)
# UPLOAD_TOKEN_SECRET=
