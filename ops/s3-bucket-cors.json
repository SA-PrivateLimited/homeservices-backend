{
  "CORSRules": [
    {
      "ID": "AkansoBrowserPresignedUploads",
      "AllowedOrigins": [
        "https://akanso.in",
        "https://www.akanso.in",
        "https://customer.akanso.in",
        "https://www.customer.akanso.in",
        "https://partner.akanso.in",
        "https://www.partner.akanso.in",
        "https://admin.akanso.in",
        "https://www.admin.akanso.in",
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:5175",
        "http://localhost:5176",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5174",
        "http://127.0.0.1:5175",
        "http://127.0.0.1:5176"
      ],
      "AllowedMethods": ["GET", "PUT", "HEAD"],
      "AllowedHeaders": [
        "Content-Type",
        "Content-Length",
        "x-amz-content-sha256",
        "x-amz-date",
        "x-amz-security-token",
        "x-amz-user-agent",
        "Authorization"
      ],
      "ExposeHeaders": [
        "ETag",
        "x-amz-request-id",
        "x-amz-id-2"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}
